# NEVER ship secrets or local cruft inside the .mcpb bundle.
.env
.env.example
*.pem

# Python caches / build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.venv/
venv/
.ruff_cache/

# OS / shell crash cruft
*.stackdump

# Packaging outputs / dev helpers (explicit names; avoid glob patterns like
# _*.py that would also match __init__.py)
*.mcpb
server.json
_build_dist.bat
_build_out.txt
_pack_only.bat

# VCS / tooling
.git/
.github/
# Local agent/IDE config. Untracked and machine-specific, so whatever happens to
# sit here on the packing machine would otherwise ride along in the bundle.
.claude/
.vscode/
.idea/
.gitattributes
.mypy_cache/
.pytest_cache/
PUBLISHING.md
RELEASING.md

# Internal working notes — not for the distributed bundle (CHANGES.md is the
# tracked, condensed changelog that ships instead of the detailed CHANGELOG.md)
CLAUDE.md
CHANGELOG.md

# Tests are not needed in the runtime bundle
tests/

# Dev tooling (token-footprint audit etc.) — not part of the runtime
scripts/
